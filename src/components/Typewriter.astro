---
// src/components/Typewriter.astro
const { text } = Astro.props;
---
<!-- Store text in a hidden div's data attribute -->
<div id="text-container" data-text={text} hidden></div>

<div class="blurb-container">
  <p id="typewriter-text" class="blurb"></p>
</div>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('typewriter-text');
    const textcontainer = document.getElementById('text-container');
    const fullText = textcontainer.dataset.text;
    console.log(fullText);
    const typingSpeed = 45;
    let i = 0;

    function typeWriter() {
      if (i < fullText.length) {
        element.textContent = fullText.substring(0, i + 1);
        i++;
        setTimeout(typeWriter, typingSpeed);
      }
    }

    // Start with empty element
    element.textContent = "";
    setTimeout(typeWriter, 500);
  });
</script>
