---
import { Image } from 'astro:assets';
import profileImg from '../media/profile-pic.jpg';
const pageTitle = 'Home Page';
const blurbText = "I am a CEng MICE Senior engineer with a passion for structural engineering, programming and technology, welcome to my personal site for anything and everything I find interesting.";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Typewriter from '../components/Typewriter.jsx';
---
<html>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <Header />
        <div class="banner">
            <div class="image-cropper">
                <Image class="profile-pic" src={profileImg} alt="profile picture"/>
            </div>
            <div>
                <Typewriter client:load text={blurbText} />
            </div>
        <script>
          import "../scripts/menu.js";
        </script>
    </body>
    <Footer />
</html>
