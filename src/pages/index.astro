---
import { Image } from 'astro:assets';
import profileImg from '../media/profile.png';
const pageTitle = 'Home Page';
const blurbText = "Welcome to my corner of the digital world, where structural engineering meets cutting-edge technology and creative coding. I'm a Senior Engineer, CEng MICE, diving deep into the world of innovation, problem-solving, and all things that spark curiosity. This space is my playground, where I share my thoughts, projects, and the ideas that keep me inspired.";
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import Typewriter from '../components/Typewriter.jsx';
---
<html>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle}</title>
    </head>
    <body>
        <div class="background-image">
            <div class="content">
                <Header />
                <div class="banner">
                    <div class="image-container">
                        <svg class="border-anim" viewbox="0 0 200 250" preserveAspectRation="none">
                            <path class="glow-path" d="M0,0 L160,0 L198,50 L198,248 L40,248 L0,198 Z"/>
                        </svg>
                        <div class="image-cropper">
                            <Image class="profile-pic" src={profileImg} alt="profile picture" format='png'/>
                        </div>
                    </div>
                    <div>
                        <Typewriter client:load text={blurbText} />
                    </div>
                <script>
                  import "../scripts/menu.js";
                </script>
            </div>
        </div>
    </body>
    <Footer />
</html>
